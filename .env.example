# Copy this file to .env and fill in the values. .env is never committed.

# Model APIs (read by the Anthropic and OpenAI client libraries)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Neo4j DBMS that holds the study database (qmsoriginal). The harness opens read-only sessions on qmsoriginal;
# the MCP server is started with these values and NEO4J_DATABASE=qmsoriginal (set by the harness).
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
